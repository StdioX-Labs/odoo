<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_pesapal" model="payment.provider">
        <field name="name">PesaPal</field>
        <field name="code">pesapal</field>
        <!-- `state` and `is_published` are deliberately NOT set here. This record is
             re-applied on every `-u payment_pesapal`, so declaring them would switch a
             live provider back to disabled/unpublished on upgrade. Both already default
             to disabled/False on a fresh install, which is the safe starting point. -->
        <!-- Without this, _get_processing_values() skips _get_specific_rendering_values()
             entirely ("if redirect_form_view:"), so checkout never reaches PesaPal. -->
        <field name="redirect_form_view_id" ref="payment_pesapal.redirect_form"/>
        <!-- Also set by post_init_hook, but that only runs on install. Declaring it here
             means an upgrade (-u payment_pesapal) restores the link if it is ever lost;
             without a linked method, _get_compatible_payment_methods() hides PesaPal. -->
        <field name="payment_method_ids" eval="[(4, ref('payment_pesapal.payment_method_pesapal'))]"/>
    </record>
</odoo>
