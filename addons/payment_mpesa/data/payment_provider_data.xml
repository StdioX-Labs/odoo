<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_mpesa" model="payment.provider">
        <field name="name">M-Pesa</field>
        <field name="code">mpesa</field>
        <!-- `state`/`is_published` intentionally omitted: this record is re-applied on
             every `-u payment_mpesa`, and setting them would silently switch a live
             provider back to disabled. Both default to disabled/False on install. -->
        <!-- NOTE: M-Pesa is not yet usable from the standard payment form (eCommerce
             checkout). It still needs an inline_form_view_id and a working inline
             template - payment_mpesa_templates.xml currently emits literal "{tx_id}"
             placeholders instead of QWeb t-att bindings. -->
    </record>
</odoo>
