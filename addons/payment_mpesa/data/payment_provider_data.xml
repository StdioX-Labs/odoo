<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_mpesa" model="payment.provider">
        <field name="name">M-Pesa</field>
        <field name="code">mpesa</field>
        <!-- `state`/`is_published` intentionally omitted: this record is re-applied on
             every `-u payment_mpesa`, and setting them would silently switch a live
             provider back to disabled. Both default to disabled/False on install. -->
        <!-- The phone number field under the M-Pesa option at checkout. Its presence
             also makes the form use the direct flow (STK Push) instead of a redirect. -->
        <field name="inline_form_view_id" ref="payment_mpesa.inline_form"/>
        <!-- Without a linked method, _get_compatible_payment_methods() hides M-Pesa
             at checkout. Declared here so an upgrade restores the link if lost. -->
        <field name="payment_method_ids" eval="[(4, ref('payment_mpesa.payment_method_mpesa'))]"/>
        <field name="pending_msg" type="html">
            <p>Check your phone and enter your M-Pesa PIN to complete the payment.</p>
        </field>
    </record>
</odoo>
