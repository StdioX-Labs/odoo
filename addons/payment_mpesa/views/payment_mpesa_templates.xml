<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shown under the M-Pesa option of Odoo's payment form (eCommerce checkout,
         portal invoices). payment_form.js reads the number and sends the STK Push. -->
    <template id="inline_form" name="M-Pesa Inline Form">
        <div t-attf-id="o_mpesa_form_{{provider_id}}" class="o_mpesa_form mb-2">
            <label t-attf-for="o_mpesa_phone_{{provider_id}}" class="form-label">
                M-Pesa phone number
            </label>
            <input type="tel"
                   name="mpesa_phone"
                   t-attf-id="o_mpesa_phone_{{provider_id}}"
                   class="form-control"
                   placeholder="07XX XXX XXX"
                   autocomplete="tel"/>
            <small class="form-text text-muted">
                You will get a prompt on this phone to enter your M-Pesa PIN.
            </small>
        </div>
    </template>
</odoo>
